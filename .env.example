# ==============================================================================
# KANCHI JEWELRY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND / CLIENT-SIDE VARIABLES (Exposed to the browser via Vite)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=

# Your Supabase Public Anonymous Key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=

# Razorpay Key ID (Found in Razorpay Dashboard > Settings > API Keys)
# NOTE: Only Key ID is public. The Key Secret is STRICTLY server-side.
VITE_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# SUPABASE EDGE FUNCTIONS SECRETS (Set in Supabase CLI or Dashboard > Secrets)
# DO NOT place these in .env or frontend bundles!
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh...
# RAZORPAY_KEY_ID=rzp_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
